{
  "name": "pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3003",
    "build": "vite build",
    "preview": "vite preview",
    "dev:electron": "concurrently \"vite --port 3003\" \"wait-on http://localhost:3003 && electron electron/main.js\"",
    "build:electron": "vite build && electron-builder --win"
  },
  "dependencies": {
    "@upos/shared-types": "workspace:*",
    "axios": "^1.9.0",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "th.dulwich.upos.pos",
    "productName": "UPOS POS Terminal",
    "win": { "target": "nsis" },
    "directories": { "output": "dist-electron" },
    "files": ["dist/**/*", "electron/**/*"]
  }
}
